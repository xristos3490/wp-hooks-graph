{
  "name": "hooks-graph",
  "version": "1.0.0",
  "description": "Parse WordPress PHP codebases for hook relationships and visualize them as an interactive graph.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:alias": "bash scripts/setup-profile.sh < /dev/tty",
    "dev": "pnpm -F @hooksgraph/viewer dev",
    "dev:viewer": "pnpm -F @hooksgraph/viewer dev",
    "dev:plugin": "pnpm -F @hooksgraph/plugin start",
    "build": "composer install && pnpm build:cli && pnpm build:plugin && pnpm build:theme",
    "build:viewer": "pnpm -F @hooksgraph/viewer build",
    "build:cli": "node scripts/build-cli.js",
    "build:plugin": "pnpm -F @hooksgraph/plugin build",
    "build:theme": "node scripts/build-theme.js",
    "mcp": "node packages/mcp/bin/hooksgraph-mcp.js",
    "test": "pnpm test:php && pnpm test:js",
    "test:php": "vendor/bin/phpunit",
    "test:js": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^3.2.4"
  }
}
