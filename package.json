{
  "name": "hooks-graph",
  "version": "1.0.0",
  "description": "Parse WordPress PHP codebases for hook relationships and visualize them as an interactive graph.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash bin/setup_profile.sh < /dev/tty",
    "parse": "php hooks_graph.php",
    "parse:help": "php hooks_graph.php --help",
    "serve": "bin/serve",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:php && npm run test:js",
    "test:php": "php tests/run.php",
    "test:js": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wordpress/components": "^32.6.0",
    "@wordpress/dataviews": "^14.1.0",
    "@wordpress/icons": "^12.2.0",
    "@wordpress/theme": "^0.11.0",
    "@wordpress/ui": "^0.11.0",
    "cytoscape": "^3.33.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.8",
    "vitest": "^3.2.4"
  }
}
