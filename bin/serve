#!/usr/bin/env bash
# Serve the Vite-built viewer with a hooks JSON.
# Usage: bin/serve [path/to/hooks.json]
# No arg: uses the most recently modified JSON in storage/.

set -euo pipefail

HG="$(cd "$(dirname "$0")/.." && pwd)"

if [ $# -ge 1 ]; then
    HOOKS_JSON="$1"
else
    HOOKS_JSON=$(ls -t "$HG/storage/"*.json 2>/dev/null | head -n 1 || true)
    if [ -z "$HOOKS_JSON" ]; then
        echo "Error: no JSON path given and no files found in storage/." >&2
        echo "Run 'npm run parse -- <dir>' first, or pass a path: bin/serve path/to/hooks.json" >&2
        exit 1
    fi
    echo "Using $HOOKS_JSON (most recent in storage/)."
fi

if [ ! -f "$HOOKS_JSON" ]; then
    echo "Error: $HOOKS_JSON not found." >&2
    exit 1
fi

# Auto-build the viewer on first run (or if dist/ was cleaned).
if [ ! -d "$HG/dist" ]; then
    if ! command -v npm >/dev/null 2>&1; then
        echo "Error: $HG/dist not found and 'npm' isn't on PATH." >&2
        echo "Install Node.js, then run 'npm install && npm run build'." >&2
        exit 1
    fi
    if [ ! -d "$HG/node_modules" ]; then
        echo "Installing Node dependencies..." >&2
        (cd "$HG" && npm install --silent)
    fi
    echo "Building viewer (first run)..." >&2
    (cd "$HG" && npm run build --silent)
fi

# Pick a browser opener: macOS `open`, Linux `xdg-open`, WSL `wslview`,
# Windows `start` — otherwise fall back to printing the URL.
OPENER=""
for candidate in open xdg-open wslview start; do
    if command -v "$candidate" >/dev/null 2>&1; then
        OPENER="$candidate"
        break
    fi
done

port=8080
while lsof -iTCP:$port -sTCP:LISTEN >/dev/null 2>&1; do
    port=$((port + 1))
done

HOOKS_JSON="$HOOKS_JSON" php -S "127.0.0.1:$port" -t "$HG/dist" "$HG/server.php" &
srv=$!
trap 'kill $srv 2>/dev/null' EXIT INT TERM

URL="http://127.0.0.1:$port"
if [ -n "$OPENER" ]; then
    (sleep 0.3 && "$OPENER" "$URL" >/dev/null 2>&1) &
else
    echo "Open $URL in your browser." >&2
fi
wait $srv
