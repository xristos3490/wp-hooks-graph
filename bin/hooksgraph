#!/usr/bin/env bash
# Parse WordPress PHP dirs for hook relationships, then serve the viewer.
# Usage: hooksgraph <dir>... [parser flags]
set -euo pipefail

HG="$(cd "$(dirname "$0")/.." && pwd)"

# If the user is asking for help or passed no args, run the parser directly so
# its stdout (help text) / stderr (usage error) reach the terminal. Capturing
# stdout via `$(... --print-path)` in those cases would swallow the help output
# into a bogus "path" and confuse bin/serve.
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            exec php "$HG/hooks_graph.php" "$@"
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    exec php "$HG/hooks_graph.php"
fi

# Parse. --print-path makes the parser emit ONLY the output path on stdout;
# its pretty UI output goes to stderr.
out=$(php "$HG/hooks_graph.php" --print-path "$@")

exec "$HG/bin/serve" "$out"
