{
    "name": "hooksgraph/wp-hooks-graph",
    "description": "Dev umbrella for the wp-hooks-graph monorepo. Individual packages live under packages/.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "packages/parser" }
    ],
    "require": {
        "php": ">=8.2",
        "hooksgraph/hooks-parser": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "HooksGraph\\Tests\\": "packages/parser/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
